{
  "name": "agelens",
  "version": "0.1.0",
  "private": true,
  "description": "AgeLens — a visual computational map of human aging and rejuvenation science.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run verify:content && npm run verify:claims && next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:content": "vitest run tests/content",
    "test:e2e": "playwright test",
    "bench": "vitest bench --run",
    "verify:content": "tsx scripts/verify-content.ts",
    "verify:claims": "tsx scripts/check-banned-claims.ts",
    "content:hash": "tsx scripts/write-manifest.ts",
    "ci": "npm run typecheck && npm run lint && npm run verify:content && npm run verify:claims && npm run test && npm run build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@xyflow/react": "^12.11.6",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "next": "^16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.20.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
